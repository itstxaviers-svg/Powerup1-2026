{
  "name": "word-code",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "dev:student": "vite --host 127.0.0.1 --port 4173",
    "dev:teacher": "VITE_APP_ROLE=teacher vite --host 127.0.0.1 --port 4174",
    "build": "tsc -b && vite build",
    "build:teacher": "tsc -b && VITE_APP_ROLE=teacher vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "images:optimise": "node scripts/optimise-images.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "tailwindcss": "^4.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.0",
    "vite": "^8.1.0",
    "vitest": "^4.0.0"
  }
}
