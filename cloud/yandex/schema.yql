CREATE TABLE teachers (
  email Utf8 NOT NULL,
  teacher_id Utf8 NOT NULL,
  display_name Utf8 NOT NULL,
  password_hash Utf8 NOT NULL,
  join_code Utf8 NOT NULL,
  created_at Timestamp NOT NULL,
  PRIMARY KEY (email)
);

CREATE TABLE groups (
  join_code Utf8 NOT NULL,
  group_id Utf8 NOT NULL,
  teacher_id Utf8 NOT NULL,
  display_name Utf8 NOT NULL,
  created_at Timestamp NOT NULL,
  PRIMARY KEY (join_code)
);

CREATE TABLE students (
  wordcode_id Utf8 NOT NULL,
  student_id Utf8 NOT NULL,
  display_name Utf8 NOT NULL,
  group_id Utf8 NOT NULL,
  group_display_name Utf8 NOT NULL,
  join_code Utf8 NOT NULL,
  avatar Utf8 NOT NULL,
  pin_hash Utf8 NOT NULL,
  created_at Timestamp NOT NULL,
  updated_at Timestamp NOT NULL,
  PRIMARY KEY (wordcode_id)
);

CREATE TABLE group_members (
  group_id Utf8 NOT NULL,
  student_id Utf8 NOT NULL,
  wordcode_id Utf8 NOT NULL,
  PRIMARY KEY (group_id, student_id)
);

CREATE TABLE progress (
  student_id Utf8 NOT NULL,
  target_id Utf8 NOT NULL,
  payload Json NOT NULL,
  updated_at Timestamp NOT NULL,
  PRIMARY KEY (student_id, target_id)
);

CREATE TABLE rewards (
  student_id Utf8 NOT NULL,
  payload Json NOT NULL,
  updated_at Timestamp NOT NULL,
  PRIMARY KEY (student_id)
);

CREATE TABLE training_sessions (
  student_id Utf8 NOT NULL,
  completed_at Timestamp NOT NULL,
  session_id Utf8 NOT NULL,
  payload Json NOT NULL,
  PRIMARY KEY (student_id, completed_at, session_id)
);

CREATE TABLE sync_events (
  student_id Utf8 NOT NULL,
  event_id Utf8 NOT NULL,
  received_at Timestamp NOT NULL,
  PRIMARY KEY (student_id, event_id)
);
